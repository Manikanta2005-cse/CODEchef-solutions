#include <stdio.h>
#include <string.h>

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    
    while (t--) {
        char S[1005];
        scanf("%s", S);
        
        int len = strlen(S);
        char A[1005];
        char B[1005];
        
        for (int i = 0; i < len; i++) {
            A[i] = S[i];
        }
        A[len] = '\0'; 
        for (int i = 0; i < len; i++) {
            B[i] = S[len - 1 - i];
        }
        B[len] = '\0';
        
        for (int i = 0; i < len; i++) {
            printf("%c", A[i]);
        }
        printf("\n");
        
        for (int i = 0; i < len; i++) {
            printf("%c", B[i]);
        }
        printf("\n");
    }
    
    return 0;
}