#include <stdio.h>
#include <string.h>

int MAX = 101;
char stack[101];
int top = 0;

void push(char val) {
    if (top == MAX) {
        printf("Overflow\n");
    } else {
        stack[top] = val;
        top++;
    }
}

void pop() {
    if (top == 0) {
        printf("Underflow\n");
    } else {
        top--;
    }
}

char check() {
    return stack[top - 1];
}

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;

    while (t--) {
        int n;
        scanf("%d", &n);

        char s[101];
        scanf("%s", s);

        top = 0;

        for (int i = 0; i < n; i++) {
            push(s[i]);
        }

        int isPalindrome = 1;
        for (int i = 0; i < n; i++) {
            if (s[i] != check()) {
                isPalindrome = 0;
                break;
            }
            pop();
        }

        if (isPalindrome) {
            printf("Yes\n");
        } else {
            printf("No\n");
        }
    }

    return 0;
}